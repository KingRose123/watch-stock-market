# 发布签名凭据 · 模板
#
# 复制成同目录下的 keystore.properties，填上你自己的值：
#
#     cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties 已被 android/.gitignore 忽略，**不会进版本库** ——
# 所以真实的密码放在那里是安全的。
#
# ── 从零生成一套签名 ─────────────────────────────────────
#
#   1) 生成密钥（有效期设长一点，过期后无法再更新同一个 App）：
#
#      keytool -genkeypair -v -storetype PKCS12 \
#        -keystore release.keystore \
#        -alias youralias -keyalg RSA -keysize 2048 -validity 10000
#
#   2) 把生成的 release.keystore 放到 android/app/ 目录下
#
#   3) 把下面三项填成你刚才设置的值
#
# ⚠️ keystore 和密码是 App 的**唯一身份**：
#     泄漏 → 任何人都能签出与你同签名的包；
#     丢失 → 已上架的 App 再也无法更新。
#    请务必在安全的地方备份（密码管理器 / 离线介质）。

storePassword=
keyAlias=
keyPassword=
